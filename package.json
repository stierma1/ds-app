{
  "name": "ds-app",
  "version": "0.1.0",
  "description": "A dependency-free JavaScript library of data structures and applications.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./b-trees": "./src/b-trees/index.ts",
    "./balanced-trees": "./src/balanced-trees/index.ts",
    "./core": "./src/core/index.ts",
    "./depq": "./src/depq/index.ts",
    "./finger-search-trees": "./src/finger-search-trees/index.ts",
    "./graphs": "./src/graphs/index.ts",
    "./hash-tables": "./src/hash-tables/index.ts",
    "./heaps": "./src/heaps/index.ts",
    "./leftist-trees": "./src/leftist-trees/index.ts",
    "./lists": "./src/lists/index.ts",
    "./mwpl-trees": "./src/mwpl-trees/index.ts",
    "./randomized": "./src/randomized/index.ts",
    "./sets": "./src/sets/index.ts",
    "./skew-heaps": "./src/skew-heaps/index.ts",
    "./splay-trees": "./src/splay-trees/index.ts",
    "./trees": "./src/trees/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test tests/unit/*.test.ts",
    "typecheck": "tsc --noEmit",
    "benchmark:phase2": "node benchmarks/phase2-load-factor.ts",
    "benchmark:phase3-depq": "node benchmarks/phase3-depq.ts",
    "benchmark:phase3-heaps": "node benchmarks/phase3-heaps.ts",
    "benchmark:phase3-leftist": "node benchmarks/phase3-leftist.ts",
    "benchmark:phase3-mwpl": "node benchmarks/phase3-mwpl.ts",
    "benchmark:phase3-skew": "node benchmarks/phase3-skew.ts",
    "benchmark:phase4-avl": "node benchmarks/phase4-avl.ts",
    "benchmark:phase4-b-trees": "node benchmarks/phase4-b-trees.ts",
    "benchmark:phase4-finger": "node benchmarks/phase4-finger.ts",
    "benchmark:phase4-randomized": "node benchmarks/phase4-randomized.ts",
    "benchmark:phase4-rb": "node benchmarks/phase4-rb.ts",
    "benchmark:phase4-splay": "node benchmarks/phase4-splay.ts",
    "benchmark:phase4-wb": "node benchmarks/phase4-wb.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
