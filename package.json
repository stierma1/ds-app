{
  "name": "ds-app",
  "version": "0.1.0",
  "description": "A dependency-free JavaScript library of data structures and applications.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./graphs": "./src/graphs/index.ts",
    "./hash-tables": "./src/hash-tables/index.ts",
    "./heaps": "./src/heaps/index.ts",
    "./lists": "./src/lists/index.ts",
    "./sets": "./src/sets/index.ts",
    "./trees": "./src/trees/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test tests/unit/*.test.ts",
    "typecheck": "tsc --noEmit",
    "benchmark:phase2": "node benchmarks/phase2-load-factor.ts",
    "benchmark:phase3-heaps": "node benchmarks/phase3-heaps.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
